name: Build BorderlineDepth

on:
  workflow_dispatch:
  push:
    paths:
      - 'BorderlineDepth_FullProject.zip'
      - '.github/workflows/build.yml'

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.14'

      - name: Extract project archive
        run: |
          unzip BorderlineDepth_FullProject.zip -d /tmp/borderline-project
          cd /tmp/borderline-project/BorderlineDepth
          gradle build

      - name: Upload JAR
        uses: actions/upload-artifact@v4
        with:
          name: BorderlineDepth-JAR
          path: /tmp/borderline-project/BorderlineDepth/build/libs/*.jar
